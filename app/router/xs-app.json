{
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "managepo/webapp",
      "authenticationType":"xsuaa"
    }
  ]
}
